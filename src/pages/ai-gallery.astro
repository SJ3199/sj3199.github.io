---
import Layout from '@/layouts/Layout.astro';
import gallery from '@/collections/gallery.json';
type AiItem = {
  image: string;
  thumbnail?: string;
  title: string;
  category: string;
  downloadEnabled?: boolean;
  original?: { url: string; filename: string; width: number; height: number };
};

const tabs = [
  { key: 'texture-wallpapers', name: '手机壁纸', i18n: 'cat-texture-wallpapers' },
  { key: 'ai-scenes', name: 'AI 场景', i18n: 'cat-ai-scenes' },
];
const defaultCategory = tabs[0].key;
const items = (gallery as AiItem[]).filter(item => tabs.some(tab => tab.key === item.category));
const hasWallpapers = items.some(item => item.category === defaultCategory);
---
<Layout title="AI 图集 · Sam Portfolio" description="AI 生成场景与手机壁纸，支持下载高清原图。" keywords="AI场景,手机壁纸,高清原图,AI图集">
  <div class="ai-page site-container">
    <header class="ai-heading">
      <h1 class="font-sans text-4xl sm:text-5xl font-bold tracking-normal text-center" data-i18n="ai-gallery-title">AI 图集</h1>
      <p class="ai-intro" data-i18n="ai-gallery-intro">源于视觉设计师的个人兴趣。本页图像均由自主设计的 AI 图像生成 Skill 完成。</p>
    </header>
    <div class="ai-toolbar">
      <div class="ai-tabs" role="group" aria-label="AI 图集分类">{tabs.map((tab,index)=><button type="button" class:list={['ai-tab',{active:index===0}]} data-filter={tab.key} aria-pressed={index===0?'true':'false'}><span data-i18n={tab.i18n}>{tab.name}</span></button>)}</div>
    </div>
    <p id="wallpaperHint" class="wallpaper-hint" data-i18n="ai-wallpaper-download-hint" hidden={!hasWallpapers}>点击壁纸下载高清原图</p>
    <p class="sr-only" id="wallpaperDownloadStatus" role="status"></p>
    <section class="ai-grid" id="aiGalleryGrid" data-active-category={defaultCategory} aria-label="AI 作品">
      {items.map((item, index) => {
        const original = item.downloadEnabled !== false && item.original?.url ? item.original : undefined;
        const preview = item.thumbnail || item.image;

        if (item.category === defaultCategory) {
          const Preview = original ? 'a' : 'div';
          const width = item.original?.width || 1440;
          const height = item.original?.height || 2560;
          return <article class="wallpaper-card" data-category={item.category}>
            <Preview class="wallpaper-preview" href={original?.url} download={original?.filename} rel={original ? 'noreferrer' : undefined}>
              <span class="phone-shell">
                <span class="phone-screen" style={`aspect-ratio:${width}/${height}`}>
                  <img src={preview} alt={item.title} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" width={width} height={height} />
                </span>
              </span>
              {original ? <>
                <span class="sr-only" data-i18n="ai-download-btn">下载高清原图</span>
                <span class="wallpaper-download" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4"/></svg></span>
              </> : <span class="wallpaper-unavailable" data-i18n="ai-no-original">这张作品暂未提供原图下载。</span>}
            </Preview>
          </article>;
        }

        const width = item.original?.width;
        const height = item.original?.height;
        return <article class="ai-card" data-category={item.category} hidden>
          <button class="ai-card-open" type="button" data-original-url={original?.url} data-original-filename={original?.filename} aria-label={`查看 ${item.title}`}>
            <div class="ai-card-media" style={width && height ? `aspect-ratio:${width}/${height}` : undefined}>
              <img src={preview} alt={item.title} loading="lazy" decoding="async" width="720" height="1280" />
            </div>
          </button>
        </article>;
      })}
    </section>
    <section class="ai-empty" id="aiEmpty" hidden={hasWallpapers}>
      <p data-i18n="ai-empty-gallery">暂无图片</p>
    </section>
  </div>
  <dialog class="ai-scene-confirm" id="aiSceneConfirm" aria-labelledby="aiSceneConfirmTitle">
    <h2 id="aiSceneConfirmTitle" data-i18n="ai-confirm-download-title">下载高清原图？</h2>
    <p id="aiSceneUnavailable" data-i18n="ai-no-original" hidden>这张作品暂未提供原图下载。</p>
    <div class="ai-scene-confirm-actions"><button type="button" id="aiSceneCancel" data-i18n="ai-cancel">取消</button><a id="aiSceneDownload" class="ai-download" rel="noreferrer" data-i18n="ai-confirm-download">确认下载</a></div>
  </dialog>
</Layout>
<style>
  :global(html.dark) .ai-page{--color-text-secondary:var(--color-text-secondary-dark);--color-text-tertiary:var(--color-text-tertiary-dark);--color-primary:var(--color-text-primary-dark)}
  .ai-page{padding-top:20px;padding-bottom:24px;min-height:calc(100svh - 170px)}
  .ai-heading{text-align:center;margin-bottom:10px}.ai-heading h1{margin:0}
  .ai-intro{max-width:960px;margin:10px auto 14px;font-size:12px;line-height:1.85;color:var(--color-text-tertiary);text-wrap:pretty}
  .ai-toolbar{display:flex;justify-content:center;margin-bottom:20px}.ai-tabs{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
  .ai-tab{display:flex;align-items:center;gap:8px;border:1px solid rgba(100,120,155,.2);background:rgba(130,150,180,.07);color:var(--color-text-secondary);border-radius:20px;padding:6px 14px;font:inherit;font-size:11px;line-height:1.5;cursor:pointer;transition:background .18s,border-color .18s}
  .ai-tab:hover{border-color:var(--color-primary)}.ai-tab.active{background:var(--color-primary);color:#fff;border-color:var(--color-primary)}
  .ai-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 12px}
  .ai-card{min-width:0;border:1px solid rgba(115,135,170,.15);border-radius:15px;overflow:hidden;background:var(--color-bg-secondary)}
  :global(html.dark) .ai-card{background:#0f1b2d}
  .ai-card-open{display:block;width:100%;border:0;padding:0;background:transparent;color:inherit;cursor:pointer;font:inherit}
  .ai-card-media{aspect-ratio:9/16;position:relative;background:rgba(120,140,170,.06);overflow:hidden}.ai-card-media img{width:100%;height:100%;object-fit:contain;display:block}
  .ai-empty{text-align:center;padding:40px 0;color:var(--color-text-tertiary)}.ai-empty p{font-size:12px;line-height:1.9;color:var(--color-text-tertiary);margin:0}
  [hidden]{display:none!important}
  @media(min-width:640px){.ai-grid{gap:26px 24px}}@media(min-width:1024px){.ai-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(min-width:1280px){.ai-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
  @media(max-width:767px){.ai-page{padding-top:14px}.ai-toolbar{margin-bottom:16px}.ai-tab{padding:5px 12px}.ai-tabs{gap:7px}}
  .wallpaper-hint{text-align:center;margin:-7px 0 22px;color:var(--color-text-secondary);font-size:12px;line-height:1.5}
  .ai-grid[data-active-category="texture-wallpapers"]{grid-template-columns:repeat(2,minmax(0,206px));justify-content:center;gap:20px 10px}
  @media(min-width:900px){.ai-grid[data-active-category="texture-wallpapers"]{grid-template-columns:repeat(4,minmax(0,206px));gap:24px 16px}}
  .wallpaper-card{min-width:0}
  .wallpaper-preview{position:relative;display:block;width:100%;border-radius:clamp(19px,3vw,28px);color:inherit;text-decoration:none}
  .wallpaper-preview:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}
  .phone-shell{position:relative;display:block;padding:4px;border:1px solid #687583;border-radius:inherit;background:linear-gradient(145deg,#525c68 1%,#111820 22%,#090d14 70%,#4d5764 100%);box-shadow:inset 0 0 0 1px #b9c5d430,0 12px 24px #02060d38}
  .phone-screen{position:relative;display:block;overflow:hidden;isolation:isolate;aspect-ratio:9/16;border-radius:clamp(14px,2.8vw,23px);background:#101722}
  .phone-screen img{display:block;width:100%;height:100%;object-fit:contain}
  .phone-screen::after{content:'';position:absolute;top:2.3%;left:50%;translate:-50% 0;width:23%;height:2.4%;border-radius:99px;background:#090e15;box-shadow:inset 0 0 0 1px #ffffff19;pointer-events:none}
  .wallpaper-download{position:absolute;right:8px;bottom:8px;display:grid;place-items:center;width:32px;height:32px;border:1px solid #ffffff45;border-radius:50%;background:#101925db;color:#fff;box-shadow:0 2px 8px #0004;transition:background .18s}
  a.wallpaper-preview:is(:hover,:focus-visible) .wallpaper-download{background:#2563b9}
  .wallpaper-unavailable{display:block;margin-top:8px;text-align:center;color:var(--color-text-tertiary);font-size:11px}
  @media(max-width:639px){.wallpaper-hint{margin:-5px 0 18px}.wallpaper-download{width:28px;height:28px}.phone-shell{padding:3px}}
  @media(prefers-reduced-motion:reduce){.wallpaper-download{transition:none}}
  @media(prefers-reduced-motion:reduce){.ai-tab{transition:none}}
  .ai-download{display:flex;align-items:center;justify-content:center;border:1px solid #ffffff25;border-radius:12px;background:linear-gradient(110deg,#397fe4,#456cce);color:#fff;font-weight:600;text-decoration:none;box-shadow:0 5px 18px #2869c72b;transition:filter .2s,transform .2s}
  .ai-download:hover{filter:brightness(1.1);transform:translateY(-1px)}
  .ai-card-open:focus-visible,.ai-download:focus-visible{outline:2px solid var(--color-primary);outline-offset:3px}
  @media(prefers-reduced-motion:reduce){.ai-download{transition:none;transform:none}}
  .ai-scene-confirm{position:fixed;inset:0;margin:auto;width:min(350px,calc(100vw - 32px));padding:28px;border:1px solid #8094b133;border-radius:20px;background:#fbfcfe;color:var(--color-text-secondary);box-shadow:0 24px 100px #0006}
  :global(html.dark) .ai-scene-confirm{background:#152135;color:var(--color-text-secondary-dark)}.ai-scene-confirm::backdrop{background:#060d1ab8;backdrop-filter:blur(10px)}
  .ai-scene-confirm h2{font-size:21px;font-weight:600;color:inherit;margin:0 0 26px}.ai-scene-confirm>p:not(.sr-only){font-size:12px;line-height:1.8;margin:0 0 22px}
  .ai-scene-confirm-actions{display:flex;gap:12px;align-items:center}.ai-scene-confirm-actions button{padding:12px 22px;border-radius:10px;border:1px solid #8094b133;color:inherit;background:transparent;font:inherit;font-size:13px;cursor:pointer}.ai-scene-confirm-actions .ai-download{flex:1;min-height:48px;padding:12px;font-size:14px}
</style>
<script>import '@/assets/js/ai-gallery';</script>
